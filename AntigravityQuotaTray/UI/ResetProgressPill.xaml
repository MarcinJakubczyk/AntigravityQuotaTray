<UserControl x:Class="AntigravityQuotaTray.UI.ResetProgressPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <!-- Outer recessed bevel rim: dark top edge, subtle light catch on bottom lip -->
    <Border CornerRadius="5.5" BorderThickness="1" Background="Transparent">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A0A0E" Offset="0.0" />
                <GradientStop Color="#1B1B22" Offset="0.5" />
                <GradientStop Color="#353542" Offset="1.0" />
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <!-- Recessed well background; its opaque rounded shape also drives the OpacityMask below -->
            <Border x:Name="InnerWell" CornerRadius="4.5" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#111115" Offset="0.0" />
                        <GradientStop Color="#16161C" Offset="0.4" />
                        <GradientStop Color="#1B1B23" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Progress fill + top inner shadow, clipped to the rounded well -->
            <Grid IsHitTestVisible="False">
                <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=InnerWell}" />
                </Grid.OpacityMask>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FillColumn" Width="0*" />
                        <ColumnDefinition x:Name="RestColumn" Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ProgressFill" Grid.Column="0" BorderThickness="0" Visibility="Collapsed">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#521D4ED8" Offset="0.0" />
                                <GradientStop Color="#662563EB" Offset="0.55" />
                                <GradientStop Color="#4838BDF8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#8860A5FA" />
                        </Border.BorderBrush>
                    </Border>
                </Grid>

                <!-- Inner top shadow cast into the recessed well (also falls over fill) -->
                <Border Height="3.5" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66000000" Offset="0.0" />
                            <GradientStop Color="#00000000" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Foreground label -->
            <TextBlock x:Name="LabelText"
                       Text="-"
                       Foreground="#A1A1AA"
                       FontSize="10.5"
                       Padding="7,1.5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
