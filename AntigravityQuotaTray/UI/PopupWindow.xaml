<Window x:Class="AntigravityQuotaTray.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AntigravityQuotaTray.UI"
        Title="Antigravity Quota"
        Width="396"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RangeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52525B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#52525B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#3B1A1E" />
            <Setter Property="Foreground" Value="#FCA5A5" />
            <Setter Property="BorderBrush" Value="#7F1D1D" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5B2329" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#991B1B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7F1D1D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7" />
            <Setter Property="MinWidth" Value="7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="2,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd"
                                                        Background="#3F3F46"
                                                        CornerRadius="3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#52525B" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#71717A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#27272A"
                                                BorderBrush="#3F3F46"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,4"
                                                TextElement.Foreground="#F4F4F5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="16" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="▾"
                                                           Foreground="#A1A1AA"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="#202026"
                                        BorderBrush="#3F3F46"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#F4F4F5" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            TextElement.Foreground="{TemplateBinding Foreground}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#3F3F46" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBd" Property="Background" Value="#2563EB" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="#18181B"
            BorderBrush="#2E2E36"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="2" Opacity="0.55" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header (drag handle) -->
            <Grid x:Name="HeaderBar"
                  Grid.Row="0"
                  Background="Transparent"
                  Cursor="SizeAll"
                  Margin="0,0,0,10"
                  ToolTip="Drag to move window"
                  MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="Antigravity Quota" Foreground="#FAFAFA" FontSize="14.5" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock x:Name="LastUpdatedText"
                               Text="Initializing..."
                               Foreground="#A1A1AA"
                               FontSize="11"
                               Margin="15,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Style="{StaticResource IconButtonStyle}" ToolTip="Refresh now" Margin="0,0,5,0" Click="OnRefreshClick">
                        <TextBlock Text="↻" FontSize="14" FontWeight="Bold" />
                    </Button>
                    <Button x:Name="PinButton" Style="{StaticResource IconButtonStyle}" ToolTip="Pin / Unpin window" Margin="0,0,5,0" Click="OnPinClick">
                        <TextBlock Text="📌" FontSize="12" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButtonStyle}" ToolTip="Settings" Click="OnSettingsToggleClick">
                        <TextBlock Text="⚙" FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="BodyScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel>

            <!-- Error Banner -->
            <Border x:Name="ErrorBanner"
                    Visibility="Collapsed"
                    Background="#2B1A1D"
                    BorderBrush="#7F1D1D"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="9,6"
                    Margin="0,0,0,9">
                <TextBlock x:Name="ErrorBannerText"
                           Foreground="#FCA5A5"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Gemini Card -->
            <Border Background="#202026" BorderBrush="#2C2C35" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="Gemini Models" Foreground="#F4F4F5" FontSize="12.5" FontWeight="SemiBold" />
                        <Border HorizontalAlignment="Right" Background="#172554" CornerRadius="4" Padding="6,1">
                            <TextBlock x:Name="TrayBadgeText" Text="Tray icon" Foreground="#60A5FA" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <!-- Gemini 5h -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="Gemini5hLabel" Text="5-hour limit" Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:ResetProgressPill x:Name="Gemini5hResetPill" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="Gemini5hPctText" Text="--" Foreground="#22C55E" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Height="7" Margin="0,0,0,8">
                        <Border Background="#2E2E38" CornerRadius="3.5" />
                        <Border x:Name="Gemini5hBarFill" HorizontalAlignment="Left" Width="0" Background="#22C55E" CornerRadius="3.5" />
                    </Grid>

                    <!-- Gemini Weekly -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="GeminiWeeklyLabel" Text="Weekly limit" Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:ResetProgressPill x:Name="GeminiWeeklyResetPill" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="GeminiWeeklyPctText" Text="--" Foreground="#22C55E" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Height="7">
                        <Border Background="#2E2E38" CornerRadius="3.5" />
                        <Border x:Name="GeminiWeeklyBarFill" HorizontalAlignment="Left" Width="0" Background="#22C55E" CornerRadius="3.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Claude & GPT Card -->
            <Border Background="#202026" BorderBrush="#2C2C35" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Claude &amp; GPT Models" Foreground="#F4F4F5" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,7" />

                    <!-- Claude 5h -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="Claude5hLabel" Text="5-hour limit" Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:ResetProgressPill x:Name="Claude5hResetPill" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="Claude5hPctText" Text="--" Foreground="#A1A1AA" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Height="7" Margin="0,0,0,8">
                        <Border Background="#2E2E38" CornerRadius="3.5" />
                        <Border x:Name="Claude5hBarFill" HorizontalAlignment="Left" Width="0" Background="#A1A1AA" CornerRadius="3.5" />
                    </Grid>

                    <!-- Claude Weekly -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="ClaudeWeeklyLabel" Text="Weekly limit" Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ui:ResetProgressPill x:Name="ClaudeWeeklyResetPill" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ClaudeWeeklyPctText" Text="--" Foreground="#A1A1AA" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Grid Height="7">
                        <Border Background="#2E2E38" CornerRadius="3.5" />
                        <Border x:Name="ClaudeWeeklyBarFill" HorizontalAlignment="Left" Width="0" Background="#A1A1AA" CornerRadius="3.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Prepaid Credits Card -->
            <Border Background="#202026" BorderBrush="#2C2C35" BorderThickness="1" CornerRadius="9" Padding="11,8" Margin="0,0,0,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="CreditsLabelText" Text="Prepaid Credits:" Foreground="#D4D4D8" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock x:Name="CreditsValueText" Text="--" Foreground="#FAFAFA" FontSize="13" FontWeight="Bold" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border x:Name="UseAiCreditsBadge" HorizontalAlignment="Right" Background="#27272A" CornerRadius="5" Padding="7,2">
                        <TextBlock x:Name="UseAiCreditsText" Text="useAiCredits: ?" Foreground="#A1A1AA" FontSize="10.5" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>

            <!-- History Chart Card -->
            <Border Background="#202026" BorderBrush="#2C2C35" BorderThickness="1" CornerRadius="9" Padding="11,9">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <TextBlock x:Name="HistoryTitleText" Text="Usage history" Foreground="#F4F4F5" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="Range6hBtn" Content="6h" Style="{StaticResource RangeButtonStyle}" Click="OnRange6hClick" />
                            <Button x:Name="Range24hBtn" Content="24h" Style="{StaticResource RangeButtonStyle}" Click="OnRange24hClick" />
                            <Button x:Name="Range7dBtn" Content="7d" Style="{StaticResource RangeButtonStyle}" Click="OnRange7dClick" />
                            <CheckBox x:Name="ShowClaudeCheck"
                                      Content="Claude"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Checked="OnShowClaudeChanged"
                                      Unchecked="OnShowClaudeChanged" />
                        </StackPanel>
                    </Grid>

                    <ui:HistoryChartControl x:Name="HistoryChart" Height="132" />

                    <StackPanel Orientation="Horizontal" Margin="2,6,0,0">
                        <Ellipse Width="7" Height="7" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="Gemini 5h" Foreground="#A1A1AA" FontSize="10.5" Margin="0,0,12,0" />
                        <Ellipse Width="7" Height="7" Fill="#34D399" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="LegendGeminiWeeklyText" Text="Gemini Weekly" Foreground="#A1A1AA" FontSize="10.5" Margin="0,0,12,0" />
                        <StackPanel x:Name="ClaudeLegendItem" Orientation="Horizontal" Visibility="Collapsed">
                            <Ellipse Width="7" Height="7" Fill="#F59E0B" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Claude 5h" Foreground="#A1A1AA" FontSize="10.5" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Collapsible Settings Panel -->
            <Border x:Name="SettingsPanel"
                    Visibility="Collapsed"
                    Background="#202026"
                    BorderBrush="#3F3F46"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="11,10"
                    Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="SettingsTitleText" Text="Settings" Foreground="#F4F4F5" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <TextBlock x:Name="LanguageLabelText" Text="Language" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3" />
                    <ComboBox x:Name="LanguageCombo" Margin="0,0,0,8" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="English" Tag="En" />
                        <ComboBoxItem Content="Polski" Tag="Pl" />
                    </ComboBox>

                    <TextBlock x:Name="PollIntervalLabelText" Text="Refresh interval" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3" />
                    <ComboBox x:Name="PollIntervalCombo" Margin="0,0,0,8" SelectionChanged="OnPollIntervalChanged">
                        <ComboBoxItem x:Name="Poll1Item" Content="Every 1 minute" Tag="1" />
                        <ComboBoxItem x:Name="Poll2Item" Content="Every 2 minutes" Tag="2" />
                        <ComboBoxItem x:Name="Poll5Item" Content="Every 5 minutes" Tag="5" />
                        <ComboBoxItem x:Name="Poll10Item" Content="Every 10 minutes" Tag="10" />
                        <ComboBoxItem x:Name="Poll15Item" Content="Every 15 minutes" Tag="15" />
                        <ComboBoxItem x:Name="Poll30Item" Content="Every 30 minutes" Tag="30" />
                        <ComboBoxItem x:Name="Poll60Item" Content="Every 60 minutes" Tag="60" />
                    </ComboBox>

                    <TextBlock x:Name="TrayStyleLabelText" Text="Tray icon style (Gemini only)" Foreground="#A1A1AA" FontSize="11" Margin="0,0,0,3" />
                    <ComboBox x:Name="TrayStyleCombo" Margin="0,0,0,9" SelectionChanged="OnTrayStyleChanged">
                        <ComboBoxItem x:Name="StyleNumberItem" Content="5h number + weekly bar" Tag="NumberWithWeeklyBar" />
                        <ComboBoxItem x:Name="StyleDualBarsItem" Content="Dual bars (5h / Weekly)" Tag="DualBars" />
                        <ComboBoxItem x:Name="StyleRingGaugeItem" Content="Ring gauge" Tag="RingGauge" />
                    </ComboBox>

                    <CheckBox x:Name="OpenOnHoverCheck"
                              Content="Open popup on tray icon hover"
                              Margin="0,0,0,6"
                              Checked="OnOpenOnHoverChanged"
                              Unchecked="OnOpenOnHoverChanged" />

                    <CheckBox x:Name="AutostartCheck"
                              Content="Start with Windows"
                              Margin="0,0,0,9"
                              Checked="OnAutostartChanged"
                              Unchecked="OnAutostartChanged" />

                    <Grid>
                        <Button x:Name="OpenDataFolderBtn"
                                Content="Open data folder"
                                HorizontalAlignment="Left"
                                Style="{StaticResource ActionButtonStyle}"
                                Click="OnOpenDataFolderClick" />
                        <Button x:Name="ExitAppBtn"
                                Content="Exit application"
                                HorizontalAlignment="Right"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="OnExitAppClick" />
                    </Grid>
                </StackPanel>
            </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
